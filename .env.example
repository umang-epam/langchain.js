# DIAL Core base URL, without a trailing slash.
# Example: https://ai-proxy.lab.epam.com
DIAL_URL=

# API key from your DIAL / EPAM AI Dial account.
DIAL_API_KEY=

# Model or application deployment id in DIAL (e.g. gpt-4o-2024-05-13).
DIAL_DEPLOYMENT=

# Optional. DIAL uses Azure OpenAI-compatible versions.
DIAL_API_VERSION=2024-02-01
